{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "NozAI",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "NozAI"
  },
  "runtimes": [
    {
      "name": "noz_ai_runtime",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/agent-template/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "global-policy.json"
      ],
      "connections": []
    }
  ],
  "memories": [
    {
      "name": "noz_ai",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "noz-ai",
      "protocolType": "MCP",
      "description": "Gateway for noz-ai",
      "targets": [
        {
          "name": "noz-ai-target",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "tool_noz_ai",
              "description": "tool_description",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "string_example": {
                    "type": "string",
                    "description": "Example de String;"
                  },
                  "client_id": {
                    "type": "integer",
                    "description": "Id do cliente;"
                  },
                  "field_example": {
                    "type": "array",
                    "description": "Exemplo de array com strings",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "string_example",
                  "field_example"
                ]
              },
              "outputSchema": {
                "type": "object",
                "properties": {
                  "example_fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "client_id": {
                          "type": "string"
                        },
                        "example_field_return": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "score": {
                          "type": "integer",
                          "description": "Tambem pode ter description"
                        }
                      }
                    }
                  },
                  "example_return": {
                    "type": "integer"
                  },
                  "motivo_vazio": {
                    "type": "string",
                    "description": "Presente só quando example_fields vem vazia; omitido no sucesso"
                  }
                },
                "required": [
                  "example_fields",
                  "example_return"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "lambda/my-tool",
              "handler": "handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_14",
            "timeout": 60,
            "memorySize": 512
            }
          }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "noz_ai_policy_engine",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "noz_ai_policy_engine",
      "policies": []
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
