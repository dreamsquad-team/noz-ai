{
  "$defs": {
    "TemaEmpresa": {
      "description": "Um assunto sobre o qual a empresa publica.",
      "properties": {
        "topico": {
          "description": "Assunto, ex.: pintura",
          "minLength": 1,
          "title": "Topico",
          "type": "string"
        },
        "conteudos": {
          "description": "Quantos conteúdos considerados da empresa têm este tópico",
          "minimum": 1,
          "title": "Conteudos",
          "type": "integer"
        },
        "evidencias": {
          "description": "Ids de conteúdos com o tópico (até 5)",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidencias",
          "type": "array"
        }
      },
      "required": [
        "topico",
        "conteudos",
        "evidencias"
      ],
      "title": "TemaEmpresa",
      "type": "object"
    }
  },
  "properties": {
    "id_empresa": {
      "description": "Empresa",
      "minLength": 1,
      "title": "Id Empresa",
      "type": "string"
    },
    "temas": {
      "description": "Temas sobre os quais a empresa publica, do mais ao menos frequente",
      "items": {
        "$ref": "#/$defs/TemaEmpresa"
      },
      "title": "Temas",
      "type": "array"
    },
    "conteudos_considerados": {
      "description": "Quantos conteúdos entraram no cálculo",
      "minimum": 0,
      "title": "Conteudos Considerados",
      "type": "integer"
    },
    "avisos": {
      "description": "O que limitou ou degradou a resposta",
      "items": {
        "type": "string"
      },
      "title": "Avisos",
      "type": "array"
    }
  },
  "required": [
    "id_empresa",
    "conteudos_considerados"
  ],
  "title": "PerfilEmpresa",
  "type": "object"
}
