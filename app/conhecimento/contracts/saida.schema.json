{
  "description": "Resumo de uma execução.",
  "properties": {
    "id_empresa": {
      "description": "Empresa processada, ou 'todas'",
      "minLength": 1,
      "title": "Id Empresa",
      "type": "string"
    },
    "janela_desde": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Início efetivo da janela processada",
      "title": "Janela Desde"
    },
    "janela_ate": {
      "description": "Fim efetivo da janela processada",
      "format": "date-time",
      "title": "Janela Ate",
      "type": "string"
    },
    "usuarios_processados": {
      "description": "Perfis de usuário atualizados",
      "minimum": 0,
      "title": "Usuarios Processados",
      "type": "integer"
    },
    "conteudos_processados": {
      "description": "Conteúdos com tema gerado ou atualizado",
      "minimum": 0,
      "title": "Conteudos Processados",
      "type": "integer"
    },
    "eventos_processados": {
      "description": "Eventos lidos na janela",
      "minimum": 0,
      "title": "Eventos Processados",
      "type": "integer"
    },
    "erros": {
      "description": "Erros ocorridos, sem stack trace",
      "items": {
        "type": "string"
      },
      "title": "Erros",
      "type": "array"
    }
  },
  "required": [
    "id_empresa",
    "janela_desde",
    "janela_ate",
    "usuarios_processados",
    "conteudos_processados",
    "eventos_processados"
  ],
  "title": "ConhecimentoSaida",
  "type": "object"
}
